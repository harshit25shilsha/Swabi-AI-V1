APP_NAME=Swabi AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_URL = "https://api.groq.com/openai/v1/chat/completions"

SWABI_API_BASE_URL=actualswabiapibaseurl
SWABI_API_KEY=your_swabi_api_key_here
SWABI_API_TIMEOUT=30

REDIS_URL=redis://localhost:6379/0

LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

ENABLE_RAG=false
ENABLE_TOOLS=false
ENABLE_EVALUATION=false