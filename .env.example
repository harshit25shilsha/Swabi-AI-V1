APP_NAME=Swabi AI
APP_ENV=development
APP_VERSION=0.1.0
SERVICE_VERSION=0.2.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# LLM — Groq (required)

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_URL = "https://api.groq.com/openai/v1/chat/completions"
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_CONSENSUS_ATTEMPTS=1
LLM_FALLBACK_ENABLED=true

# LLM — Gemini fallback (optional; leave GEMINI_API_KEY empty to disable)

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_SECONDS=15

# LLM — circuit breaker

LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_SECONDS=60

# Swabi backend

SWABI_API_BASE_URL=your_swabi_api_base_url_here
SWABI_API_KEY=your_swabi_api_key_here
SWABI_API_TIMEOUT=30

# Redis

REDIS_URL=redis://localhost:6379/0


# Guardrail service (inbound auth for /api/v1/validate-message)
#
# This is a service-to-service credential. It is NOT a user JWT.
# Do not forward user tokens to the guardrail endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

GUARDRAIL_API_TOKEN=replace-with-a-long-random-token


# Feature flags
ENABLE_TOOLS=false
ENABLE_EVALUATION=false

# ---------------------------------------------------------------------------
# RAG — embeddings + Qdrant (Batch 2B)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=swabi_chunks
QDRANT_TIMEOUT=30

RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIM=384
RAG_EMBEDDING_BATCH_SIZE=32


# RAG - Retriebal + answer
ENABLE_RAG=true
rag_top_k=5
rag_min_score=0.45

# Swabi backend response encryption (CryptoJS AES)
#
# The passphrase used by the frontend to decrypt responses. Leave empty if
# the backend returns plain JSON for the AI service.

SWABI_RESPONSE_PASSPHRASE=
SWABI_RESPONSE_KDF=md5